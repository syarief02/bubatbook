# Copy to .env.local. Only VITE_* variables are exposed to the browser.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional, server-side only: for running migrations or maintenance from your own
# machine. The app never uses them. Never commit real values.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
